# The model. openai/gpt-4o is what this template was verified with.
# anthropic/claude-sonnet-5 is supported by the code but was not tested; llm.py takes either.
MODEL=openai/gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# One. Key from https://app.withone.ai/settings/api-keys (setup.sh runs `one init` with it).
ONE_SECRET=

# Connection keys from `one --agent list --search <platform>`. Leave empty when the platform has exactly one connection.
ONE_YOU_CONNECTION_KEY=
ONE_NOTION_CONNECTION_KEY=
ONE_SLACK_CONNECTION_KEY=

# What to watch, where to write, where to post.
WATCHLIST=AAPL, NVDA, BTC
NOTION_PARENT_PAGE_ID=
SLACK_CHANNEL=
RESEARCH_EFFORT=deep
