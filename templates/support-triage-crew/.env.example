# The model. openai/gpt-4o is what this template was verified with.
# anthropic/claude-sonnet-5 is supported by the code but was not tested; llm.py takes either.
MODEL=openai/gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# One. Key from https://app.withone.ai/settings/api-keys (setup.sh runs `one init` with it).
# The crew's MCP server reads ONE_SECRET from the environment; the CLI-side tools read .onerc, which preflight writes.
ONE_SECRET=

# Connection keys from `one --agent list --search <platform>`. Leave empty when the platform has exactly one connection.
ONE_GMAIL_CONNECTION_KEY=
ONE_DAYTONA_CONNECTION_KEY=
ONE_LINEAR_CONNECTION_KEY=
ONE_SLACK_CONNECTION_KEY=

# Where bugs go.
LINEAR_TEAM_KEY=ENG
SLACK_CHANNEL=
# Which emails count as support reports. SUPPORT_QUERY is Gmail search syntax; SUPPORT_PREFIX is a literal
# subject prefix checked in code, because Gmail's search ignores the brackets.
SUPPORT_QUERY=is:unread subject:"[support]" newer_than:2d
SUPPORT_PREFIX=[support]
