# The model. openai/gpt-4o is what this template was verified with.
# anthropic/claude-sonnet-5 is supported by the code but was not tested; llm.py takes either.
MODEL=openai/gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# One. Key from https://app.withone.ai/settings/api-keys (setup.sh runs `one init` with it).
ONE_SECRET=

# Connection key from `one --agent list --search github`. Leave empty when there is exactly one.
ONE_GITHUB_CONNECTION_KEY=

# The repository to review. The GitHub connection must be able to post reviews on it.
GITHUB_OWNER=
GITHUB_REPO=

# Required for `--remember`. Comma-separated GitHub logins allowed to teach this agent.
# A feedback comment rewrites the agent's review rules, so anyone not named here is ignored.
FEEDBACK_LOGINS=
