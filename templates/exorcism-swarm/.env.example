# The model, on Parasail (OpenAI-compatible, not a One platform). Key from https://www.saas.parasail.io/keys
# The model must support tool calling. List what your key can use:
#   curl -s https://api.parasail.io/v1/models -H "Authorization: Bearer $PARASAIL_API_KEY" | jq -r '.data[].id'
# Other tool-calling candidates: parasail-deepseek-v4-flash, parasail-qwen3p6-35b-a3b, parasail-glm-52
PARASAIL_API_KEY=
PARASAIL_MODEL=parasail-kimi-k26

# One. Key from https://app.withone.ai/settings/api-keys. The Analyst's MCP server and the CLI both read it.
ONE_SECRET=

# Connection keys from `one --agent list --search <platform>`. Leave empty when the platform has exactly one connection.
ONE_YOU_CONNECTION_KEY=
ONE_SLACK_CONNECTION_KEY=
ONE_LINEAR_CONNECTION_KEY=

# Where the swarm writes. Nothing else is ever written to.
# SLACK_CHANNEL is a channel id (C0123...); invite the Slack bot to it. LINEAR_TEAM_KEY is the team's short key (ENG).
SLACK_CHANNEL=
LINEAR_TEAM_KEY=

# The facility feed. Empty runs the local mock in facility_sim.py.
# Set it to the starter repo's simulation (or `python facility_sim.py --serve 8077`) to read over HTTP.
FEED_URL=
SIM_TICKS=6
SIM_SEED=31
